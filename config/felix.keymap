#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&caps_word { continue-list = <UNDERSCORE MINUS>; };

&lt {
    tapping-term-ms = <150>;
    quick-tap-ms = <200>;
    flavor = "balanced";
    require-prior-idle-ms = <125>;
};

&mt {
    tapping-term-ms = <150>;
    quick-tap-ms = <200>;
    flavor = "balanced";
    require-prior-idle-ms = <125>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            display-name = "Home Row Mod (Left)";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49 57 58 59 60 61 62 63>;
        };

        hmr: home_row_mod_right {
            display-name = "Home Row Mod (Right)";
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 16 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54 55 56 17>;
        };

        hll: home_row_layer_tap_left {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49 57 58 59 60 61 62 63>;
        };

        hlr: home_row_layer_tap_right {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 16 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54 55 56 17>;
        };

        as: hold_tap_autoshift {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&sh>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };

        mm_altF1: mod_morph_alt_F1 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp N1>, <&kp F1>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        mm_altF2: mod_morph_alt_F2 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp N2>, <&kp F2>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        mm_altF3: mod_morph_alt_F3 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp N3>, <&kp F3>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        mm_altF4: mod_morph_alt_F4 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp N4>, <&kp F4>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        mm_altF5: mod_morph_alt_F5 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp N5>, <&kp F5>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        mm_altF6: mod_morph_alt_F6 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp N6>, <&kp F6>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        mm_altF7: mod_morph_alt_F7 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp N7>, <&kp F7>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        mm_altF8: mod_morph_alt_F8 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp N8>, <&kp F8>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        mm_altF9: mod_morph_alt_F9 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp N9>, <&kp F9>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        mm_altF10: mod_morph_alt_F10 {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp N0>, <&kp F10>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
    };

    macros {
        sh: shifted_keypress {
            display-name = "Shifted Keypress";
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LSHFT &macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER &kp LSHFT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        lbrc {
            bindings = <&kp LBRC>;
            key-positions = <14 26>;
            layers = <0>;
        };

        lbkt {
            bindings = <&kp LBKT>;
            key-positions = <15 27>;
            layers = <0>;
        };

        lpar {
            bindings = <&kp LPAR>;
            key-positions = <16 28>;
            layers = <0>;
        };

        lt {
            bindings = <&kp LT>;
            key-positions = <17 29>;
            layers = <0>;
        };

        gt {
            bindings = <&kp GT>;
            key-positions = <18 30>;
            layers = <0>;
        };

        rpar {
            bindings = <&kp RPAR>;
            key-positions = <19 31>;
            layers = <0>;
        };

        rbkt {
            bindings = <&kp RBKT>;
            key-positions = <20 32>;
            layers = <0>;
        };

        rbrc {
            bindings = <&kp RBRC>;
            key-positions = <21 33>;
            layers = <0>;
        };

        launcher_l {
            bindings = <&kp LG(SPACE)>;
            key-positions = <28 26>;
        };

        launcher_r {
            bindings = <&kp RG(SPACE)>;
            key-positions = <31 33>;
        };

        colemak {
            bindings = <&to 0>;
            key-positions = <0 1 2>;
        };

        qwerty {
            bindings = <&to 4>;
            key-positions = <1 2 3>;
            layers = <0>;
        };

        fun {
            bindings = <&sl 3>;
            key-positions = <2 3 4>;
            layers = <0>;
        };

        game {
            bindings = <&to 5>;
            key-positions = <3 4 5>;
        };

        bt_clr_all {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <9 11 10>;
            layers = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        cmak {
            display-name = "colemak";
            bindings = <
&as TILDE GRAVE  &mm_altF1    &mm_altF2    &mm_altF3  &mm_altF4     &mm_altF5                                            &mm_altF6       &mm_altF7     &mm_altF8        &mm_altF9     &mm_altF10      &as MINUS UNDER
&kp TAB          &kp Q        &kp W        &lt 3 F    &kp P         &kp B                                                &kp J           &kp L         &lt 3 U          &kp Y         &as DOT SQT     &kp BSPC
&hml ESC LCTRL   &hml LGUI A  &hml LALT R  &kp S      &hll 1 T      &kp G                                                &kp M           &hlr 2 N      &kp E            &hmr LALT I   &hmr RGUI O     &hmr RCTRL RET
&as PLUS EQUAL   &kp Z        &kp X        &kp C      &kp D         &kp V            &to 1                &to 2          &kp K           &kp H         &as QMARK COMMA  &as EXCL DOT  &as TILDE FSLH  &as PIPE BSLH
&kp HOME         &kp PG_DN    &kp PG_UP    &kp END    &mt LALT ESC  &mt LCTRL SPACE  &mt LSHFT TAB        &mt RSHFT RET  &mt RCTRL BSPC  &mt LALT DEL  &kp LEFT         &kp DOWN      &kp UP          &kp RIGHT
            >;
        };

        nav {
            display-name = "navigation";
            bindings = <
&trans  &trans          &trans           &trans     &trans  &trans                                                   &trans           &trans         &trans     &trans     &trans   &trans
&trans  &trans          &trans           &kp PIPE   &trans  &to 4                                                    &kp HOME         &kp PG_DN      &kp PG_UP  &kp END    &kp INS  &trans
&trans  &hml LGUI SEMI  &hml LALT GRAVE  &kp COLON  &trans  &to 5                                                    &kp LEFT         &kp DOWN       &kp UP     &kp RIGHT  &trans   &trans
&trans  &trans          &trans           &kp BSLH   &trans  &trans           &to 0                  &to 0            &kp PSCRN        &kp RC(PSCRN)  &trans     &trans     &trans   &trans
&trans  &trans          &trans           &trans     &trans  &mt LCTRL UNDER  &mt LSHFT MINUS        &mt RSHFT MINUS  &mt RCTRL UNDER  &trans         &trans     &trans     &trans   &trans
            >;
        };

        num {
            display-name = "number";
            bindings = <
&trans  &trans           &trans          &trans          &trans          &trans                                                   &trans           &trans  &trans     &trans           &trans          &trans
&trans  &as TILDE GRAVE  &as QMARK FSLH  &as EQUAL PLUS  &as PLUS EQUAL  &as BSLH PIPE                                            &to 4            &trans  &kp PIPE   &trans           &trans          &trans
&trans  &as PIPE N1      &as AT N2       &as HASH N3     &as DLLR N4     &as PRCNT N5                                             &to 5            &trans  &kp COLON  &hmr LALT GRAVE  &hmr RGUI SEMI  &trans
&trans  &as CARET N6     &as AMPS N7     &as STAR N8     &as GRAVE N9    &as PIPE N0      &to 0                  &to 0            &trans           &trans  &kp BSLH   &trans           &trans          &trans
&trans  &trans           &trans          &trans          &trans          &mt LCTRL UNDER  &mt LSHFT MINUS        &mt RSHFT MINUS  &mt RCTRL UNDER  &trans  &trans     &trans           &trans          &trans
            >;
        };

        fun {
            display-name = "fun";
            bindings = <
&trans  &trans   &trans   &trans   &trans   &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&trans  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15                        &kp F11       &kp F12       &kp F13       &kp F14       &kp F15       &trans
&trans  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                         &kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &trans
&trans  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &trans        &trans  &kp F6        &kp F7        &kp F8        &kp F9        &kp F10       &trans
&trans  &trans   &trans   &trans   &trans   &trans   &trans        &trans  &trans        &trans        &trans        &trans        &trans        &trans
            >;
        };

        qwty {
            display-name = "qwerty";
            bindings = <
&as TILDE GRAVE  &mm_altF1    &mm_altF2    &mm_altF3  &mm_altF4     &mm_altF5                                            &mm_altF6       &mm_altF7     &mm_altF8        &mm_altF9     &mm_altF10      &as UNDER MINUS
&kp TAB          &kp Q        &kp W        &lt 3 E    &kp R         &kp T                                                &kp Y           &kp U         &lt 3 I          &kp O         &as DQT SQT     &kp BSPC
&as LCTRL ESC    &hml LGUI A  &hml LALT S  &kp D      &hll 1 F      &kp G                                                &kp H           &hlr 2 J      &kp K            &hmr LALT L   &hmr RGUI P     &as COLON SEMI
&sk LSHFT        &kp Z        &kp X        &kp C      &kp V         &kp B            &tog 1               &to 2          &kp N           &kp M         &as QMARK COMMA  &as EXCL DOT  &as TILDE FSLH  &as PIPE BSLH
&kp HOME         &kp PG_DN    &kp PG_UP    &kp END    &mt LALT ESC  &mt LCTRL SPACE  &mt LSHFT TAB        &mt RSHFT RET  &mt RCTRL BSPC  &mt LALT DEL  &kp LEFT         &kp DOWN      &kp UP          &kp RIGHT
            >;
        };

        game {
            display-name = "game";
            bindings = <
&kp GRAVE  &mm_altF1  &mm_altF2  &mm_altF3     &mm_altF4        &mm_altF5                                          &mm_altF6       &mm_altF7     &mm_altF8        &mm_altF9     &mm_altF10      &kp PG_UP
&kp MINUS  &kp Q      &kp W      &kp E         &kp R            &kp T                                              &kp Y           &kp U         &kp I            &kp O         &as DQT SQT     &kp PG_DN
&kp EQUAL  &kp A      &kp S      &kp D         &kp F            &kp G                                              &kp H           &kp J         &kp K            &kp L         &kp P           &as COLON SEMI
&kp COMMA  &kp Z      &kp X      &kp C         &kp V            &kp B          &to 6                &to 6          &kp N           &kp M         &as QMARK COMMA  &as EXCL DOT  &as TILDE FSLH  &as PIPE BSLH
&kp DOT    &kp LBKT   &kp RBKT   &mt LALT ESC  &mt LCTRL SPACE  &mt LSHFT TAB  &mt LGUI BSPC        &mt RSHFT RET  &mt RCTRL BSPC  &mt LALT DEL  &kp LEFT         &kp DOWN      &kp UP          &kp RIGHT
            >;
        };

        emag {
            display-name = "emag";
            bindings = <
&kp F11  &mm_altF6  &mm_altF7  &mm_altF8        &mm_altF9     &mm_altF10                            &trans  &trans  &trans  &trans  &trans  &trans
&kp F12  &kp Y      &kp U      &kp I            &kp O         &as DQT SQT                           &trans  &trans  &trans  &trans  &trans  &trans
&kp F13  &kp H      &kp J      &kp K            &kp L         &kp P                                 &trans  &trans  &trans  &trans  &trans  &trans
&kp F14  &kp N      &kp M      &as QMARK COMMA  &as EXCL DOT  &as TILDE FSLH  &to 5         &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp F15  &to 1      &to 2      &trans           &trans        &trans          &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
